diff --git a/libs/tests/tls_cert_test.c b/libs/tests/tls_cert_test.c
index 045a36f..b574e40 100644
--- a/libs/tests/tls_cert_test.c
+++ b/libs/tests/tls_cert_test.c
@@ -1205,6 +1205,30 @@ TEST(tls_cert_crl_revocation_reject)
 	system(cmd);
 }
 
+/* ---- F1/T0391：生产 TLS 上下文显式锁定最低协议版本为 TLS1.3 ---- */
+TEST(tls_cert_min_proto_version_enforced)
+{
+	const char *cert_dir = get_cert_dir();
+	tls_cert_server_options_t opts = { 0 };
+	opts.mtls_enabled = 1;
+	opts.cert_dir = cert_dir;
+	tls_cert_ctx_t *ctx = NULL;
+	assert(tls_cert_init_server(&opts, &ctx) == TLS_CERT_OK && ctx != NULL);
+
+	/* 两个算法 slot 的 SSL_CTX 均须显式锁定最低版本 TLS1.3（不依赖 OpenSSL 默认值） */
+	SSL_CTX *sctx_aes =
+		tls_cert_get_ssl_ctx(ctx, RPC_TLS_ALGORITHM_AES_256_GCM_SHA384);
+	assert(sctx_aes != NULL);
+	assert(SSL_CTX_get_min_proto_version(sctx_aes) == TLS1_3_VERSION);
+
+	SSL_CTX *sctx_sm4 =
+		tls_cert_get_ssl_ctx(ctx, RPC_TLS_ALGORITHM_SM4_GCM_SM3);
+	assert(sctx_sm4 != NULL);
+	assert(SSL_CTX_get_min_proto_version(sctx_sm4) == TLS1_3_VERSION);
+
+	tls_cert_cleanup(ctx);
+}
+
 int main()
 {
 	/* 忽略 SIGPIPE：负向握手用例中一端关闭连接后，对端 SSL_write 会收到
@@ -1232,6 +1256,7 @@ int main()
 	RUN_TEST(tls_cert_ctx_reload);
 	RUN_TEST(tls_cert_error_code_normalized);
 	RUN_TEST(tls_cert_crl_revocation_reject);
+	RUN_TEST(tls_cert_min_proto_version_enforced);
 	printf("\n=== Results ===\n");
 	printf("Passed: %d\n", tests_passed);
 	printf("Failed: %d\n", tests_failed);
