+		tls_cert_log_setup_error(is_server ? "server" : "client",
+					"min-proto-version", profile->algorithm,
+					profile->ca_cert, profile->cert,
+					profile->key);
+		SSL_CTX_free(ctx);
+		ERR_clear_error();
+		return TLS_CERT_ERR_SSL_CREATE;
+	}
+
 	if (tls_cert_set_ciphersuites(ctx, profile->algorithm) != TLS_CERT_OK) {
 		tls_cert_log_setup_error(is_server ? "server" : "client",
 					 "ciphersuites", profile->algorithm,
