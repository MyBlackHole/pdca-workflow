+/* 证书 CN 合法性校验（单一实现见 libs/common.c）。
+ * 规则与客户端 tls_cert_ca_cn_valid 一致：非空、仅 [A-Za-z0-9._-]、
+ * 禁止 ".." 子串。tls-keygen 生成 ca/host 前必须用它拒绝非法 CN，
+ * 避免部署后握手期才暴露。 */
+int cn_name_valid(const char *cn);
+
 /* 各模块函数名别名（真实实现唯一） */
