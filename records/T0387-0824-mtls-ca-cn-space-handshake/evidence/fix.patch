diff --git a/libs/common.c b/libs/common.c
index 7480488e..6e76392e 100644
--- a/libs/common.c
+++ b/libs/common.c
@@ -317,3 +317,20 @@ void close_from(int lowfd)
 		close(fd);
 	}
 }
+
+int cn_name_valid(const char *cn)
+{
+	size_t i;
+	if (!cn || !cn[0])
+		return 0;
+	for (i = 0; cn[i]; i++) {
+		char c = cn[i];
+		if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		      (c >= '0' && c <= '9') || c == '.' || c == '_' ||
+		      c == '-'))
+			return 0;
+	}
+	if (strstr(cn, "..") != NULL)
+		return 0;
+	return 1;
+}
