 	if (strcmp(algorithm, RPC_TLS_ALGORITHM_SM4_GCM_SM3) != 0 &&
 	    strcmp(algorithm, RPC_TLS_ALGORITHM_AES_256_GCM_SHA384) != 0)
 		return TLS_CERT_ERR_INVALID_PARAM;
-	/* ca 按算法区分：AES 用 ed25519 前缀新格式（回退在 slot_create） */
