-		ca_file = CERT_FILE_SM2_CA;
-	else
-		ca_file = CERT_FILE_ED25519_CA;
-	tls_cert_join_path(ca_out, ca_sz, cert_dir, ca_file);
-	/* cert/key 固定为 cert_dir/ca_cn/host.*（与 sec_tls_client_cert_paths 一致） */
+	/* T0388: SM2 链整体采用 cert_dir/<ca_cn>/ 前缀子目录布局，
+	 * 与 keygen sign -n 的自包含目录输出对齐（ca+cert+key 三件套同目录，
+	 * 部署要求：目录内需含 sm2_ca.crt/sm2_host.crt/sm2_host.key）；仅认前缀名，不下沉 */
+	if (strcmp(algorithm, RPC_TLS_ALGORITHM_SM4_GCM_SM3) == 0) {
+		tls_cert_join_path(dir_cn, sizeof(dir_cn), cert_dir, ca_cn);
