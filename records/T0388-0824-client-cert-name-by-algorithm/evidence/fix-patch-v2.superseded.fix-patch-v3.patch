+/* T0388 AC-2: SM2 客户端子目录前缀布局（cert_dir/<ca_cn>/sm2_*） */
+TEST(tls_cert_init_client_sm2_prefixed_layout)
+{
+	char tmp[] = "/tmp/tls_test_sm2_XXXXXX";
+	assert(mkdtemp(tmp) != NULL);
+	char sub[512];
+	snprintf(sub, sizeof(sub), "%s/My_CA", tmp);
+	assert(mkdir(sub, 0755) == 0);
+	const char *src_dir = get_cert_dir();
+	char src[512], dst[512];
+	static const char *pairs[][2] = {
+		{ "SM2_Test_CA/ca.crt", "sm2_ca.crt" },
+		{ "SM2_Test_CA/host.crt", "sm2_host.crt" },
+		{ "SM2_Test_CA/host.key", "sm2_host.key" },
+	};
+	for (size_t i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++) {
+		path_join(src, sizeof(src), src_dir, pairs[i][0]);
+		path_join(dst, sizeof(dst), sub, pairs[i][1]);
+		assert(copy_file(src, dst) == 0);
+	}
+
+	tls_cert_ctx_t *ctx = NULL;
+	int ret = tls_cert_init_client_from_cert_dir(tmp, RPC_TLS_ALGORITHM_SM4_GCM_SM3,
+						     "My_CA", &ctx);
+	assert(ret == TLS_CERT_OK && ctx != NULL);
+	tls_cert_cleanup(ctx);
+}
