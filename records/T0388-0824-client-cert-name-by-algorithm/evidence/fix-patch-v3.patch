+/* T0388: 按新客户端布局把 CA 证书放入 <ca_cn>/ 子目录
+ * （对齐 keygen sign -n 的自包含输出；源优先 ed25519_ca.crt，缺失用 ca.crt） */
+static int test_copy_ca_into_cn_dir(const char *src_dir, const char *ca_cn_dir)
+{
+	char src[512], dst[512];
+	path_join(src, sizeof(src), src_dir, "ed25519_ca.crt");
+	if (access(src, R_OK) != 0)
+		path_join(src, sizeof(src), src_dir, "ca.crt");
+	path_join(dst, sizeof(dst), ca_cn_dir, "ed25519_ca.crt");
+	if (copy_file(src, dst) != 0)
+		return -1;
+	/* 整套语义：host 证书/私钥同样以 ed25519_ 前缀摆放 */
+	path_join(src, sizeof(src), src_dir, "host.crt");
+	path_join(dst, sizeof(dst), ca_cn_dir, "ed25519_host.crt");
+	if (copy_file(src, dst) != 0)
+		return -1;
+	path_join(src, sizeof(src), src_dir, "host.key");
+	path_join(dst, sizeof(dst), ca_cn_dir, "ed25519_host.key");
+	return copy_file(src, dst);
+}
