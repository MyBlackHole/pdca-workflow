+/* T0388: ED25519 整套格式选择——默认整套使用 ed25519_ 前缀名；
+ * 当前缀 CA 文件缺失时，整套下沉到同目录无前缀名（ca/host 三件），
+ * 不允许 CA 与主机证书混用两种命名。
+ * 判定锚：ca 路径以 ed25519_ca.crt 结尾且存在 → 保持前缀整套；
+ *         以其结尾但不存在 → 整套下沉；其余（非前缀输入）原样返回。 */
+static void tls_cert_pick_ed25519_set(const char *ca_in, const char *cert_in,
+				      const char *key_in,
+				      const char **ca_out, const char **cert_out,
+				      const char **key_out)
+{
+	static __thread char fb_ca[1024], fb_cert[1024], fb_key[1024];
+	if (!ca_in || strcmp(ca_in + strlen(ca_in) - strlen(CERT_FILE_ED25519_CA),
+			     CERT_FILE_ED25519_CA) != 0 ||
+	    tls_cert_file_exists(ca_in)) {
+		*ca_out = ca_in;
+		*cert_out = cert_in;
+		*key_out = key_in;
+		return;
 	}
-	return primary;
-}
