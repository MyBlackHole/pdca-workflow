-{
-	static __thread char fallback[1024];
-	if (primary && strstr(primary, CERT_FILE_ED25519_HOST_KEY) != NULL) {
-		if (tls_cert_file_exists(primary))
-			return primary;
-		const char *slash = strrchr(primary, '/');
-		if (slash) {
-			size_t dir_len = slash - primary + 1;
