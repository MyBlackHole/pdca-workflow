-			    sizeof(fallback)) {
-				memcpy(fallback, primary, dir_len);
-				strcpy(fallback + dir_len, CERT_FILE_HOST_KEY);
-				if (tls_cert_file_exists(fallback))
-					return fallback;
-			}
-		}
+	const char *slash = strrchr(ca_in, '/');
+	if (!slash)
+		goto keep_prefixed;
+	{
+		size_t dir_len = (size_t)(slash - ca_in) + 1;
+		if (dir_len + strlen(CERT_FILE_CA) >= sizeof(fb_ca))
+			goto keep_prefixed;
+		memcpy(fb_ca, ca_in, dir_len);
+		strcpy(fb_ca + dir_len, CERT_FILE_CA);
+		if (!tls_cert_file_exists(fb_ca))
+			goto keep_prefixed; /* 无前缀套也不完整：保持原路径 fail-closed */
+		strcpy(fb_cert, fb_ca);
+		strcpy(fb_key, fb_ca);
+		if (dir_len + strlen(CERT_FILE_HOST) < sizeof(fb_cert))
+			strcpy(fb_cert + dir_len, CERT_FILE_HOST);
+		if (dir_len + strlen(CERT_FILE_HOST_KEY) < sizeof(fb_key))
+			strcpy(fb_key + dir_len, CERT_FILE_HOST_KEY);
+		*ca_out = fb_ca;
+		*cert_out = fb_cert;
+		*key_out = fb_key;
+		return;
 	}
-	return primary;
+keep_prefixed:
+	*ca_out = ca_in;
+	*cert_out = cert_in;
+	*key_out = key_in;
 }
 
