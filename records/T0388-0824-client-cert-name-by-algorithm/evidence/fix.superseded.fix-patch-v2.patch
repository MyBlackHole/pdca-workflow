 	RUN_TEST(tls_cert_init_client_from_cert_dir);
+	RUN_TEST(tls_cert_init_client_sm2_prefixed_layout);
 	RUN_TEST(tls_cert_init_disabled);
 	RUN_TEST(tls_ed25519_dual_format);
 	RUN_TEST(tls_server_init);
diff --git a/libs/tls_cert.c b/libs/tls_cert.c
index 43ff4760..6b27b5e6 100644
--- a/libs/tls_cert.c
+++ b/libs/tls_cert.c
@@ -428,7 +428,6 @@ int tls_cert_build_client_profile(const char *cert_dir, const char *algorithm,
 				  char *cert_out, size_t cert_sz, char *key_out,
 				  size_t key_sz)
 {
-	const char *ca_file;
 	char dir_cn[1024];
 	if (!cert_dir || !cert_dir[0] || !ca_out || !cert_out || !key_out)
 		return TLS_CERT_ERR_INVALID_PARAM;
@@ -439,13 +438,19 @@ int tls_cert_build_client_profile(const char *cert_dir, const char *algorithm,
 	if (strcmp(algorithm, RPC_TLS_ALGORITHM_SM4_GCM_SM3) != 0 &&
 	    strcmp(algorithm, RPC_TLS_ALGORITHM_AES_256_GCM_SHA384) != 0)
 		return TLS_CERT_ERR_INVALID_PARAM;
-	/* ca 按算法区分：AES 用 ed25519 前缀新格式（回退在 slot_create） */
-	if (strcmp(algorithm, RPC_TLS_ALGORITHM_SM4_GCM_SM3) == 0)
-		ca_file = CERT_FILE_SM2_CA;
-	else
-		ca_file = CERT_FILE_ED25519_CA;
-	tls_cert_join_path(ca_out, ca_sz, cert_dir, ca_file);
-	/* cert/key 固定为 cert_dir/ca_cn/host.*（与 sec_tls_client_cert_paths 一致） */
+	/* T0388: SM2 链整体采用 cert_dir/<ca_cn>/ 前缀子目录布局，
+	 * 与 keygen sign -n 的自包含目录输出对齐（ca+cert+key 三件套同目录，
+	 * 部署要求：目录内需含 sm2_ca.crt/sm2_host.crt/sm2_host.key）；仅认前缀名，不下沉 */
+	if (strcmp(algorithm, RPC_TLS_ALGORITHM_SM4_GCM_SM3) == 0) {
+		tls_cert_join_path(dir_cn, sizeof(dir_cn), cert_dir, ca_cn);
+		tls_cert_join_path(ca_out, ca_sz, dir_cn, CERT_FILE_SM2_CA);
+		tls_cert_join_path(cert_out, cert_sz, dir_cn, CERT_FILE_SM2_HOST);
+		tls_cert_join_path(key_out, key_sz, dir_cn, CERT_FILE_SM2_HOST_KEY);
+		return TLS_CERT_OK;
+	}
+	/* AES/ED25519：CA 取自 cert_dir 根（ed25519 双格式回退在 slot_create），
+	 * cert/key 为 cert_dir/ca_cn/host.*（与 sec_tls_client_cert_paths 一致） */
+	tls_cert_join_path(ca_out, ca_sz, cert_dir, CERT_FILE_ED25519_CA);
 	tls_cert_join_path(dir_cn, sizeof(dir_cn), cert_dir, ca_cn);
 	tls_cert_join_path(cert_out, cert_sz, dir_cn, CERT_FILE_HOST);
 	tls_cert_join_path(key_out, key_sz, dir_cn, CERT_FILE_HOST_KEY);
diff --git a/libs/tls_keygen.c b/libs/tls_keygen.c
index 0981d4b8..e4ae7dcf 100644
--- a/libs/tls_keygen.c
+++ b/libs/tls_keygen.c
@@ -1162,6 +1162,36 @@ static int handle_sign(int argc, char *argv[])
 		return 1;
 	}
 
+	/* T0388: -n 自包含目录场景把 CA 证书一并拷入 <cn>/ 目录，
+	 * 使客户端可按 cert_dir/<ca_cn>/ 布局直接取用三件套 */
+	if (cn) {
+		char ca_dst[512];
+		snprintf(ca_dst, sizeof(ca_dst), "%s%s/%s", DEFAULT_CERT_DIR,
+			 cn, keygen_ca_cert_file(algo));
+		FILE *src = fopen(final_ca_cert, "r");
+		if (!src) {
+			fprintf(stderr,
+				"Warning: failed to read CA cert for copy: %s\n",
+				final_ca_cert);
+			return 0;
+		}
+		FILE *dst = fopen(ca_dst, "w");
+		if (!dst) {
+			fclose(src);
+			fprintf(stderr,
+				"Warning: failed to write CA cert copy: %s\n",
+				ca_dst);
+			return 0;
+		}
+		char buf[4096];
+		size_t n;
+		while ((n = fread(buf, 1, sizeof(buf), src)) > 0)
+			fwrite(buf, 1, n, dst);
+		fclose(src);
+		fclose(dst);
+		printf("CA certificate copied: %s\n", ca_dst);
+	}
+
 	return 0;
 }
 
