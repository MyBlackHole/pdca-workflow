 #include <openssl/rand.h>
 #include <time.h>
-#include <sys/stat.h>
+#include <stdint.h>
+#include <inttypes.h>
 
 static int g_verbose = 0;
 
@@ -564,22 +565,27 @@ int tls_keygen_sign_with_algo(const char *ca_cert_path,
 	}
 
 	/* 序列号必须唯一：同 CA 下多张 host 证书硬编码 2 会冲突 CRL/校验。
-	 * 用 RAND_bytes 生成 63 位正整数，失败回退到 time+pid 混合。 */
+	 * 用 RAND_bytes 生成 63 位正整数，失败回退到 clock_gettime 纳秒熵。 */
 	{
-		long long serial = 0;
+		int64_t serial = 0;
 		unsigned char rnd[8];
 		if (RAND_bytes(rnd, sizeof(rnd)) == 1) {
+			uint64_t u = 0;
 			for (size_t i = 0; i < sizeof(rnd); i++)
-				serial = (serial << 8) | rnd[i];
-			serial &= 0x7fffffffffffffffLL;
+				u = (u << 8) | rnd[i];
+			u &= 0x7fffffffffffffffULL;
+			serial = (int64_t)u;
 		}
 		if (serial == 0) {
-			serial = (long long)time(NULL) ^ (long long)getpid() ^
-				 (long long)random();
-			if (serial < 0)
-				serial = -serial;
-			if (serial == 0)
-				serial = 1;
+			struct timespec ts;
+			clock_gettime(CLOCK_REALTIME, &ts);
+			uint64_t fb = (uint64_t)ts.tv_sec ^ (uint64_t)ts.tv_nsec ^
+				      (uint64_t)getpid() ^ (uint64_t)(uintptr_t)&serial;
+			fb &= 0x7fffffffffffffffULL;
+			if (fb == 0)
+				fb = 1;
+			serial = (int64_t)fb;
+			dump_openssl_errors("RAND_bytes fallback");
 		}
 		ASN1_INTEGER_set_int64(X509_get_serialNumber(cert), serial);
 	}
