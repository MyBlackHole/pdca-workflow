-	} else if (MATCH(SECTION_NAME, "retry")) {
-		p_config->retry = atoi(value);
-	} else if (MATCH(SECTION_NAME, "keepalive")) {
-		p_config->keepalive = atoi(value);
-	} else if (MATCH(SECTION_NAME, "read_timeout")) {
-		p_config->read_timeout = atoi(value);
-	} else if (MATCH(SECTION_NAME, "parallel")) {
-		p_config->parallel = atoi(value);
-	} else {
-		return 0;
-	}
-	return 1;
-}
-
 int fsclient_check_config(CliConfig *p_config, char *err_msg, int len)
 {
 	if (p_config->check_data != 0 && p_config->check_data != 1) {
@@ -57,26 +33,44 @@ int fsclient_check_config(CliConfig *p_config, char *err_msg, int len)
 	return 0;
