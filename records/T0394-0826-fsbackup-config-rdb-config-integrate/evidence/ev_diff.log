-static int parse_config(const char *config_file, char *err_msg, int len)
+static int fsclient_parse_config(const char *config_file, char *err_msg, int len)
 {
-	int tmp_index = (config_index + 1) % 2;
-	CliConfig *p_config = &_config[tmp_index];
-
-	*p_config = *g_pConfig;
+	const char *config_path = config_file != NULL ? config_file :
+							DEFAULT_RDB_CONFIG_PATH;
 
-	if (ini_parse(config_file, do_parse_config, p_config) < 0) {
+	/* 接入集中式 rdb config 参数注册表：reload 时重新解析中央 rdb.conf 刷新
+	 * store；参数经 sec_get_* 走 env>工具段>默认 的解析链，与全仓统一参数
+	 * 管理一致。解析失败且文件缺失（ENOENT）则保留默认值，与历史行为一致。 */
+	if (parse_config(config_path, err_msg, len) != 0) {
+		if (errno == ENOENT)
+			return 0;
 		return -1;
 	}
-	if (fsclient_check_config(p_config, err_msg, len) < 0) {
+
+	/* sec_get_bool 非法值返回 -1（fail-closed）；CliConfig.check_data 为 bool
+	 * 会截断 -1 成 1，故先用 int 临时量拦截，非法即拒绝启动。 */
+	CliConfig tmp = *g_pConfig;
+	int v;
+	v = sec_get_bool(PARAM_FSCLIENT_CHECK_DATA);
+	if (v < 0) {
+		snprintf(err_msg, len, "invalid [fsclient]check_data");
