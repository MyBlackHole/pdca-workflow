-	set_rpc_retry(g_pConfig->retry);
-	set_rpc_read_timeout(g_pConfig->read_timeout);
-	set_rpc_parallel(g_pConfig->parallel);
+	tmp.check_data = (bool)v;
+	tmp.retry = sec_get_int(PARAM_FSCLIENT_RETRY);
+	tmp.keepalive = sec_get_int(PARAM_FSCLIENT_KEEPALIVE);
+	tmp.read_timeout = sec_get_int(PARAM_FSCLIENT_READ_TIMEOUT);
+	tmp.parallel = sec_get_int(PARAM_FSCLIENT_PARALLEL);
+
+	if (fsclient_check_config(&tmp, err_msg, len) < 0)
+		return -1;
+
+	set_rpc_check_data(tmp.check_data);
+	set_rpc_keepalive_interval(tmp.keepalive);
+	set_rpc_retry(tmp.retry);
+	set_rpc_read_timeout(tmp.read_timeout);
+	set_rpc_parallel(tmp.parallel);
+	*g_pConfig = tmp;
 	return 0;
 }
 
