 	return -1;
 }
 
+int rpc_get_time(const char *ip, unsigned short port, uint64_t *timestamp)
+{
+	int fd = -1;
+	struct sockaddr_in serveraddr = { 0 };
+	rpc_io_t io;
+	int ret;
+	if (!ip || !timestamp)
+		return -1;
+	fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0)
+		return -1;
+	serveraddr.sin_family = AF_INET;
+	serveraddr.sin_port = htons(port);
+	if (inet_pton(AF_INET, ip, &serveraddr.sin_addr) <= 0 ||
+	    connect(fd, (struct sockaddr *)&serveraddr, sizeof(serveraddr)) != 0)
+		goto error;
+	rpc_io_init_plain(&io, fd);
+	ret = rpc_hs_request_time(&io, timestamp);
+	rpc_hs_session_cleanup(&io);
+	close(fd);
+	return ret;
+error:
+	close(fd);
+	return -1;
+}
+
 
