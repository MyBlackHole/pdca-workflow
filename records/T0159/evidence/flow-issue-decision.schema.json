{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/flow-issue-decision.schema.json",
  "title": "Immutable Flow Issue governance decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "record_id",
    "issue_id",
    "candidate_id",
    "idempotency_key",
    "action",
    "reason",
    "impact",
    "authorization",
    "decided_at"
  ],
  "properties": {
    "schema": {"const": "pdca.flow-issue-decision/v1"},
    "decision_id": {"type": "string", "pattern": "^FD-[0-9a-f]{24}$"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "issue_id": {"type": "string", "pattern": "^FI-[0-9a-f]{24}$"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^FC-[0-9a-f]{24}$"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "enum": [
        "false-positive",
        "accepted-risk",
        "close",
        "set-impact",
        "promote-candidate",
        "verified"
      ]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "impact": {"type": ["string", "null"], "enum": [null, "low", "medium", "high", "critical"]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reference", "confirmed_by", "confirmed_at"],
      "properties": {
        "mode": {"enum": ["user-confirmation", "effectiveness-verdict"]},
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
        },
        "confirmed_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    },
    "decided_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "set-impact"}}, "required": ["action"]},
      "then": {"properties": {"impact": {"enum": ["low", "medium", "high", "critical"]}}},
      "else": {"properties": {"impact": {"type": "null"}}}
    },
    {
      "if": {"properties": {"action": {"const": "promote-candidate"}}, "required": ["action"]},
      "then": {"properties": {"candidate_id": {"type": "string", "pattern": "^FC-[0-9a-f]{24}$"}}},
      "else": {"properties": {"candidate_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"action": {"const": "verified"}}, "required": ["action"]},
      "then": {"properties": {"authorization": {"properties": {"mode": {"const": "effectiveness-verdict"}}}}},
      "else": {"properties": {"authorization": {"properties": {"mode": {"const": "user-confirmation"}}}}}
    }
  ]
}
