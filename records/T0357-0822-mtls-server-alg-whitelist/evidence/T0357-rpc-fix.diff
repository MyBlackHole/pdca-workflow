+uint16_t hs_negotiate_algorithm(uint16_t client_alg, uint16_t *negotiated)
+{
+	if (client_alg != HS_ALG_SM4_GCM_SM3 &&
+	    client_alg != HS_ALG_AES_256_GCM_SHA384)
+		return HS_ERR_ALGORITHM;
+	*negotiated = client_alg;
+	return 0;
+}
