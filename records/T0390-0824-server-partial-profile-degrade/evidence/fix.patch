diff --git a/libs/tests/tls_cert_test.c b/libs/tests/tls_cert_test.c
index 82ab775f..045a36f3 100644
--- a/libs/tests/tls_cert_test.c
+++ b/libs/tests/tls_cert_test.c
@@ -221,6 +221,40 @@ TEST(tls_cert_init_client_from_cert_dir)
 static int copy_file(const char *src, const char *dst);
 
 /* T0388 AC-2: SM2 客户端子目录前缀布局（cert_dir/<ca_cn>/sm2_*） */
+/* T0390: 服务端单算法 profile 失败降级为仅可用算法 */
+TEST(tls_cert_init_server_partial_degrade)
+{
+	char tmp[] = "/tmp/tls_test_partial_XXXXXX";
+	assert(mkdtemp(tmp) != NULL);
+	const char *src_dir = get_cert_dir();
+	char sc[512], dc[512];
+	static const char *pairs[][2] = {
+		{ "sm2_ca.crt", "sm2_ca.crt" },
+		{ "sm2_host.crt", "sm2_host.crt" },
+		{ "sm2_host.key", "sm2_host.key" },
+	};
+	for (size_t i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++) {
+		path_join(sc, sizeof(sc), src_dir, pairs[i][0]);
+		path_join(dc, sizeof(dc), tmp, pairs[i][1]);
+		assert(copy_file(sc, dc) == 0);
+	}
+	tls_cert_server_options_t sopts = { 0 };
+	sopts.mtls_enabled = 1;
+	sopts.cert_dir = tmp;
+	tls_cert_ctx_t *ctx = NULL;
+	assert(tls_cert_init_server(&sopts, &ctx) == TLS_CERT_OK);
+	assert(ctx != NULL);
+	assert(tls_cert_get_ssl_ctx(ctx, RPC_TLS_ALGORITHM_SM4_GCM_SM3) != NULL);
+	assert(tls_cert_get_ssl_ctx(ctx, RPC_TLS_ALGORITHM_AES_256_GCM_SHA384) ==
+	       NULL);
+	tls_cert_cleanup(ctx);
+
+	char empty[] = "/tmp/tls_test_empty_XXXXXX";
+	assert(mkdtemp(empty) != NULL);
+	tls_cert_ctx_t *ctx2 = NULL;
+	assert(tls_cert_init_server_from_cert_dir(empty, &ctx2) != TLS_CERT_OK);
+	assert(ctx2 == NULL);
+}
