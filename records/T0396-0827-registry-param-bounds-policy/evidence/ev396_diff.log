-		const char *val = config_get_string(get_config_store(),
-						    p->layer2_section,
-						    p->layer2_key);
-		if (val && val[0])
-			return val;
+	if (!val && p->layer2_section && p->layer2_key) {
+		const char *v = config_get_string(get_config_store(),
+						 p->layer2_section,
+						 p->layer2_key);
+		if (v && v[0])
+			val = v;
 	}
-	if (p->layer3_section && p->layer3_key) {
-		const char *val = config_get_string(get_config_store(),
-						    p->layer3_section,
-						    p->layer3_key);
-		if (val && val[0])
-			return val;
+	if (!val && p->layer3_section && p->layer3_key) {
+		const char *v = config_get_string(get_config_store(),
+						 p->layer3_section,
+						 p->layer3_key);
+		if (v && v[0])
+			val = v;
 	}
-	return p->def;
+	if (!val)
+		val = p->def; /* 缺失→默认串 */
+	if (val == NULL)
+		return NULL;
+
+	int r = sec_test_str_bounds(p, val);
+	if (r == -1)
+		return NULL; /* 超长 fail-closed */
+	if (r == 0) /* 超长回落默认 */
+		return p->def ? p->def : NULL;
+	return val;
 }
 
