+	cleanup_temp(path);
+	cleanup_temp(path2);
+}
+
+TEST(sec_get_str_overlength_fail_closed_real)
+{
+	/* 真实参数 PARAM_RPC_DEV_PATH 注册为 maxlen=4095，超长 env 应 FAIL_CLOSED
