+/* T0395：tunable 经注册表 PARAM_RPC_* 读取（env > [aio-speedd] > [aio-speed] > def） */
+
+TEST(tunables_read_from_aio_speedd)
+{
+	const char *ini = "[aio-speedd]\n"
+			  "check_data = 1\n"
+			  "debug = 1\n"
+			  "keepalive = 25\n"
+			  "parallel = 8\n"
+			  "read_timeout = 5000\n"
+			  "retry = 7\n"
+			  "fsbackup_dev_path = /dev/rpc_x\n";
+	char *path = write_temp_ini(ini);
+	char err[1024];
+
+	unsetenv("RPC_TOOL_CHECK_DATA");
+	unsetenv("RPC_TOOL_DEBUG");
+	unsetenv("RPC_TOOL_KEEPALIVE");
+	unsetenv("RPC_TOOL_PARALLEL");
+	unsetenv("RPC_TOOL_READ_TIMEOUT");
+	unsetenv("RPC_TOOL_RETRY");
+	unsetenv("RPC_TOOL_DEV_PATH");
+
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	assert(rpc_init_config(NULL, err, sizeof(err)) == 0);
+
+	assert(g_rpc_config->check_data == 1);
+	assert(g_rpc_config->debug == 1);
+	assert(g_rpc_config->keepalive == 25);
+	assert(g_rpc_config->parallel == 8);
+	assert(g_rpc_config->read_timeout == 5000);
+	assert(g_rpc_config->retry == 7);
+	assert(strcmp(g_rpc_config->dev_path, "/dev/rpc_x") == 0);
+
+	cleanup_temp(path);
+}
+
+TEST(invalid_bool_fail_closed)
+{
+	const char *ini = "[aio-speedd]\ncheck_data = 2\n";
+	char *path = write_temp_ini(ini);
+	char err[1024];
+
+	unsetenv("RPC_TOOL_CHECK_DATA");
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	/* 非法布尔触发 fail-closed：rpc_init_config 响亮返回 -1 */
+	assert(rpc_init_config(NULL, err, sizeof(err)) == -1);
+
+	cleanup_temp(path);
+}
+
+TEST(out_of_range_tunable_fail_closed)
+{
+	/* T0396：INT 范围已下沉到注册表；retry 注册 min=1，越界（0）应 fail-closed
+	 * 拒绝启动——验证工具侧冗余范围检查移除后行为不变。 */
+	const char *ini = "[aio-speedd]\nretry = 0\n";
+	char *path = write_temp_ini(ini);
+	char err[1024];
+
+	unsetenv(RPC_TOOL_RETRY_ENV);
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	assert(rpc_init_config(NULL, err, sizeof(err)) == -1);
+
+	/* 合法值（5）仍正常解析 */
+	const char *ini2 = "[aio-speedd]\nretry = 5\n";
+	char *path2 = write_temp_ini(ini2);
+	assert(parse_config(path2, err, sizeof(err)) == 0);
+	assert(rpc_init_config(NULL, err, sizeof(err)) == 0);
+	assert(g_rpc_config->retry == 5);
+
+	cleanup_temp(path);
+	cleanup_temp(path2);
+}
+
+TEST(layer3_aio_speed_fallback)
+{
+	/* 仅 [aio-speed] 段有值（无 [aio-speedd]），回落 layer3；
+	 * 等价于旧默认段读取路径，保证嵌入方（fs-backup 等）无回归 */
+	const char *ini = "[aio-speed]\nkeepalive = 77\n";
+	char *path = write_temp_ini(ini);
+	char err[1024];
+
+	unsetenv("RPC_TOOL_KEEPALIVE");
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	assert(rpc_init_config(NULL, err, sizeof(err)) == 0);
+	assert(g_rpc_config->keepalive == 77);
+
+	cleanup_temp(path);
+}
+
+TEST(env_overrides_section)
+{
+	const char *ini = "[aio-speedd]\nkeepalive = 25\n";
+	char *path = write_temp_ini(ini);
+	char err[1024];
+
+	setenv(RPC_TOOL_KEEPALIVE_ENV, "99", 1);
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	assert(rpc_init_config(NULL, err, sizeof(err)) == 0);
+	assert(g_rpc_config->keepalive == 99);
+
+	unsetenv(RPC_TOOL_KEEPALIVE_ENV);
+	cleanup_temp(path);
+}
+
