+/* 边界策略（T0396，STR 版）：返回三态——1=合法，-1=FAIL_CLOSED（超长拒绝），
+ * 0=回落默认。maxlen==0 表示不限制。供 sec_walk_str 与单测共同使用。 */
+int sec_test_str_bounds(const config_param_desc_t *p, const char *val)
+{
+	if (p->maxlen == 0)
+		return 1; /* 未限制，合法 */
+	if ((long)strlen(val) > (long)p->maxlen) {
+		if (p->invalid_policy == CFG_INVALID_FAIL_CLOSED)
+			return -1;
+		return 0; /* 回落默认 */
+	}
+	return 1;
+}
