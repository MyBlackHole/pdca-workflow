+TEST(sec_test_int_bounds_both_policies)
+{
+	config_param_desc_t d = {
+		.env_name = NULL,
+		.layer2_section = NULL, .layer2_key = NULL,
+		.layer3_section = NULL, .layer3_key = NULL,
+		.type = CFG_TYPE_INT,
+		.def = "5",
+		.desc = "test",
+		.restrict_range = 1, .min = 1, .max = 10,
+		.maxlen = 0, .invalid_policy = CFG_INVALID_FAIL_CLOSED,
+	};
+	/* FAIL_CLOSED：越界拒绝 */
+	assert(sec_test_int_bounds(&d, 0) == -1);
+	assert(sec_test_int_bounds(&d, 11) == -1);
+	assert(sec_test_int_bounds(&d, 1) == 1);
+	assert(sec_test_int_bounds(&d, 10) == 1);
+	assert(sec_test_int_bounds(&d, 5) == 1);
+	/* FALLBACK_DEFAULT：越界回落（0），范围内仍合法 */
+	d.invalid_policy = CFG_INVALID_FALLBACK_DEFAULT;
+	assert(sec_test_int_bounds(&d, 0) == 0);
+	assert(sec_test_int_bounds(&d, 11) == 0);
+	assert(sec_test_int_bounds(&d, 5) == 1);
+	/* 未限制（restrict_range=0）任何值合法 */
+	d.restrict_range = 0;
+	assert(sec_test_int_bounds(&d, -999) == 1);
+}
+
+TEST(sec_test_str_bounds_both_policies)
+{
+	config_param_desc_t s = {
+		.env_name = NULL,
+		.layer2_section = NULL, .layer2_key = NULL,
+		.layer3_section = NULL, .layer3_key = NULL,
+		.type = CFG_TYPE_STR,
+		.def = "def",
+		.desc = "test",
+		.restrict_range = 0, .min = 0, .max = 0,
+		.maxlen = 5, .invalid_policy = CFG_INVALID_FAIL_CLOSED,
+	};
+	assert(sec_test_str_bounds(&s, "abc") == 1);
+	assert(sec_test_str_bounds(&s, "abcdef") == -1); /* 6>5 超长拒绝 */
+	s.invalid_policy = CFG_INVALID_FALLBACK_DEFAULT;
+	assert(sec_test_str_bounds(&s, "abcdef") == 0);  /* 超长回落 */
+	assert(sec_test_str_bounds(&s, "abc") == 1);
+}
+
+TEST(sec_get_int_range_fail_closed_real)
+{
+	/* 真实参数 PARAM_RPC_RETRY 注册为 min=1，越界（0）应 fail-closed 返回 -1 */
+	unsetenv(RPC_TOOL_RETRY_ENV);
+	const char *ini =
+		"[aio-speedd]\n"
+		"retry = 0\n";
+	char *path = write_temp_ini(ini);
+	char err[256];
+	assert(parse_config(path, err, sizeof(err)) == 0);
+	assert(sec_get_int(PARAM_RPC_RETRY) == -1);
+
+	const char *ini2 =
+		"[aio-speedd]\n"
+		"retry = 5\n";
+	char *path2 = write_temp_ini(ini2);
+	assert(parse_config(path2, err, sizeof(err)) == 0);
+	assert(sec_get_int(PARAM_RPC_RETRY) == 5);
