# Editor and local caches
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
# Local secrets and explicitly private evidence are never publication inputs.
.env
records/*/artifacts/private/

# Cross-project private evidence remains local; this is not an access-control boundary.
records/**/artifacts/private/
records/projects/**/private/

# Local installation leftovers and bytecode (ignore is not access control).
.pdca-install.json
.pdca-install*.lock
__pycache__/
*.pyc
*.tar.gz
*.tar
