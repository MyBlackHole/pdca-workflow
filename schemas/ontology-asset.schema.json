{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pdca.asset/v1 (ontology extension)",
  "type": "object",
  "required": ["schema", "id", "type", "layer", "summary", "status"],
  "properties": {
    "schema": {"const": "pdca.asset/v1"},
    "id": {"type": "string", "pattern": "^ontology:.+"},
    "type": {"type": "string", "enum": ["domain", "entity", "concept", "process", "role", "pattern", "principle", "pitfall", "fact", "decision"]},
    "layer": {"enum": ["Evidence", "Experience", "Knowledge", "Skill"]},
    "summary": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "desc", "constraint", "testable_signal"],
        "properties": {
          "name": {"type": "string"},
          "desc": {"type": "string"},
          "constraint": {"type": "string"},
          "testable_signal": {"type": "string"}
        }
      }
    },
    "relations": {
      "type": "object",
      "properties": {
        "specializes": {"type": "array", "items": {"type": "string"}},
        "instance_of": {"type": "array", "items": {"type": "string"}},
        "composed_of": {"type": "array", "items": {"type": "string"}},
        "configured_by": {"type": "array", "items": {"type": "string"}},
        "part_of": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "relates_to": {"type": "array", "items": {"type": "string"}}
      }
    },
    "domain": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "also_type": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["active", "deprecated", "superseded"]}
  }
}
