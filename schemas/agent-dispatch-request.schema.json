{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/agent-dispatch-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_id", "expected_state", "ontology_role", "execution_contract_digest",
    "projection_manifest_digest", "context_manifest_digest", "fresh_context_required", "created_at", "request_digest"
  ],
  "properties": {
    "schema": {"const": "pdca.agent-dispatch-request/v1"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "expected_state": {"const": "undispatched"},
    "ontology_role": {"enum": ["ontology_modeling", "ontology_projection", "ontology_conformance_verification"]},
    "execution_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projection_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "context_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fresh_context_required": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
