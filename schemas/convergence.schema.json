{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/convergence.schema.json",
  "title": "PDCA convergence evidence map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "pdca.convergence/v1"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "text", "criteria", "evidence_ids"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
