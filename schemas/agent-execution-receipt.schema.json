{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/agent-execution-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "previous_receipt_digest", "recorded_at", "task_id", "event", "payload", "receipt_digest"],
  "properties": {
    "schema": {"const": "pdca.agent-execution-receipt/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_receipt_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "event": {
      "enum": ["dispatch_requested", "agent_bound", "agent_completed", "agent_failed", "agent_awaiting_confirmation", "user_confirmation_recorded", "conformance_verified", "conformance_failed"]
    },
    "payload": {"type": "object"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "dispatch_requested"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/dispatch"}}}},
    {"if": {"properties": {"event": {"const": "agent_bound"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/binding"}}}},
    {"if": {"properties": {"event": {"const": "agent_completed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/completion"}}}},
    {"if": {"properties": {"event": {"const": "agent_failed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/message"}}}},
    {"if": {"properties": {"event": {"const": "agent_awaiting_confirmation"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/confirmation_request"}}}},
    {"if": {"properties": {"event": {"const": "user_confirmation_recorded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/confirmation_recorded"}}}},
    {"if": {"properties": {"event": {"enum": ["conformance_verified", "conformance_failed"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/conformance"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bound": {
      "type": "object",
      "required": ["agent_id", "request_digest"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_digest", "request"],
      "properties": {
        "request_digest": {"$ref": "#/$defs/digest"},
        "request": {"type": "object"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_digest", "agent_id", "adapter", "fresh_context", "fork_context", "ontology_role", "execution_contract_digest", "projection_manifest_digest", "context_manifest_digest"],
      "properties": {
        "request_digest": {"$ref": "#/$defs/digest"},
        "agent_id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "fresh_context": {"const": true},
        "fork_context": {"const": false},
        "ontology_role": {"enum": ["ontology_modeling", "ontology_projection", "ontology_conformance_verification"]},
        "execution_contract_digest": {"$ref": "#/$defs/digest"},
        "projection_manifest_digest": {"$ref": "#/$defs/digest"},
        "context_manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "completion": {
      "allOf": [
        {"$ref": "#/$defs/bound"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "request_digest", "artifacts", "evidence_manifest", "evidence_manifest_digest"],
          "properties": {
            "agent_id": {"type": "string", "minLength": 1},
            "request_digest": {"$ref": "#/$defs/digest"},
            "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
            "evidence_manifest": {"type": "string", "minLength": 1},
            "evidence_manifest_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "message": {
      "allOf": [
        {"$ref": "#/$defs/bound"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "request_digest", "message"],
          "properties": {
            "agent_id": {"type": "string", "minLength": 1},
            "request_digest": {"$ref": "#/$defs/digest"},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "confirmation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "request_digest", "message", "clarification_count_before", "clarifications_digest_before"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/digest"},
        "message": {"type": "string", "minLength": 1},
        "clarification_count_before": {"type": "integer", "minimum": 0},
        "clarifications_digest_before": {"$ref": "#/$defs/digest"}
      }
    },
    "confirmation_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "request_digest", "recorded_by", "clarifications_path", "clarifications_file_digest", "clarification_index", "clarification_digest", "clarification"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/digest"},
        "recorded_by": {"const": "coordinator"},
        "clarifications_path": {"type": "string", "pattern": "^pdca/tasks/[^/]+/clarifications\\.jsonl$"},
        "clarifications_file_digest": {"$ref": "#/$defs/digest"},
        "clarification_index": {"type": "integer", "minimum": 1},
        "clarification_digest": {"$ref": "#/$defs/digest"},
        "clarification": {"type": "object"}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_by", "decision", "reason", "review_action", "review_bundle", "review_digest"],
      "properties": {
        "recorded_by": {"const": "coordinator"},
        "decision": {"enum": ["confirmed", "rejected"]},
        "reason": {"type": "string", "minLength": 1},
        "review_action": {"const": "ontology_conformance_verification"},
        "review_bundle": {"type": "string", "minLength": 1},
        "review_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
