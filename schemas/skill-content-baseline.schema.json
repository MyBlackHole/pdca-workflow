{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/skill-content-baseline.schema.json",
  "title": "PDCA flow and skill content baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metric", "assets"],
  "properties": {
    "schema": {"const": "pdca.skill-content-baseline/v1"},
    "metric": {"const": "utf8_bytes"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "reason"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:flows/flow-[a-z0-9-]+/SKILL\\.md|skills/(?:[A-Za-z0-9_.-]+/)*SKILL\\.md|ontology/domain/skill-[a-z0-9-]+\\.md)$"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
