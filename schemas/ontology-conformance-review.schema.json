{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/ontology-conformance-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "ontology_role", "review_action", "inputs", "gates", "evidence_entry_count", "result", "digest"],
  "properties": {
    "schema": {"const": "pdca.ontology-conformance-review/v1"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "ontology_role": {"enum": ["ontology_modeling", "ontology_projection", "ontology_conformance_verification"]},
    "review_action": {"const": "ontology_conformance_verification"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "agent_receipts", "transition_receipts", "evidence_manifest", "work_products"],
      "properties": {
        "task": {"$ref": "#/$defs/input"},
        "agent_receipts": {"$ref": "#/$defs/input"},
        "transition_receipts": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "evidence_manifest": {"$ref": "#/$defs/input"},
        "work_products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}}
      }
    },
    "gates": {"type": "object"},
    "evidence_entry_count": {"type": "integer", "minimum": 0},
    "result": {"const": "pending"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
