{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/ontology-projection-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "ontology_role", "ontology_anchor", "execution_contract_digest", "layers", "digest"],
  "properties": {
    "schema": {"const": "pdca.ontology-projection/v1"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "ontology_role": {"enum": ["ontology_modeling", "ontology_projection", "ontology_conformance_verification"]},
    "ontology_anchor": {"type": "string", "pattern": "^ontology:.+/.+$"},
    "execution_contract_digest": {"$ref": "#/$defs/digest"},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_ontology_graph", "bounded_task_subgraph", "execution_tree_or_dag"],
      "properties": {
        "authoritative_ontology_graph": {"$ref": "#/$defs/graph"},
        "bounded_task_subgraph": {"$ref": "#/$defs/bounded_graph"},
        "execution_tree_or_dag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projection", "leaves"],
          "properties": {
            "projection": {"enum": ["tree", "dag"]},
            "leaves": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/leaf"}
            }
          }
        }
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "source_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^ontology:.+$"},
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^ontology/.+\\.md$"},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "bounded_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "source_digest", "selection"],
      "properties": {
        "id": {"type": "string", "pattern": "^ontology:.+$"},
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^ontology/.+\\.md$"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "selection": {"enum": ["task_anchor", "explicit_task_authority"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "relation", "target"],
      "properties": {
        "source": {"type": "string"},
        "relation": {"type": "string"},
        "target": {"type": "string"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "relation_vocabulary"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "relation_vocabulary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governed_by", "source_path", "source_digest", "relation_keys"],
          "properties": {
            "governed_by": {"const": "ontology:concept/ontology-rule-non-dangling"},
            "source_path": {"type": "string", "pattern": "^ontology/.+\\.md$"},
            "source_digest": {"$ref": "#/$defs/digest"},
            "relation_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "bounded_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bounded_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ontology_node", "required_action_index", "required_action", "task_step", "completion_criterion", "depends_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^action-[0-9]{3}$"},
        "ontology_node": {"type": "string", "pattern": "^ontology:.+/.+$"},
        "required_action_index": {"type": "integer", "minimum": 1},
        "required_action": {"type": "string", "minLength": 1},
        "task_step": {"type": "string", "minLength": 1},
        "completion_criterion": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^action-[0-9]{3}$"}}
      }
    }
  }
}
