{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/improvement-candidate.schema.json",
  "title": "Immutable dry-run Flow Improvement candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "record_id",
    "issue_id",
    "event_ids",
    "idempotency_key",
    "kind",
    "status",
    "root_cause_hypothesis",
    "target_component",
    "baseline",
    "metrics",
    "risks",
    "observation_plan",
    "origin_verdict_id",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "pdca.improvement-candidate/v1"},
    "candidate_id": {"type": "string", "pattern": "^FC-[0-9a-f]{24}$"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "issue_id": {"type": "string", "pattern": "^FI-[0-9a-f]{24}$"},
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^FE-[0-9a-f]{24}$"}
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {"enum": ["improvement", "rollback"]},
    "status": {"enum": ["dry-run", "pending-confirmation"]},
    "root_cause_hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "target_component": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "baseline": {"type": "string", "minLength": 1, "maxLength": 2000},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "observation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_version", "min_opportunities", "max_observation_days"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "rule_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "min_opportunities": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_observation_days": {"type": "integer", "minimum": 1, "maximum": 3650}
      }
    },
    "origin_verdict_id": {"type": ["string", "null"], "pattern": "^FV-[0-9a-f]{24}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "improvement"}}, "required": ["kind"]},
      "then": {"properties": {"status": {"const": "dry-run"}, "origin_verdict_id": {"type": "null"}}},
      "else": {
        "properties": {
          "status": {"const": "pending-confirmation"},
          "origin_verdict_id": {"type": "string", "pattern": "^FV-[0-9a-f]{24}$"}
        }
      }
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseline", "target"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "baseline": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "target": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    }
  }
}
