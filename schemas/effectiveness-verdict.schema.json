{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/effectiveness-verdict.schema.json",
  "title": "Immutable Flow Improvement effectiveness verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict_id",
    "record_id",
    "candidate_id",
    "issue_id",
    "idempotency_key",
    "deployment",
    "observation",
    "outcome",
    "follow_up",
    "verdict_at"
  ],
  "properties": {
    "schema": {"const": "pdca.effectiveness-verdict/v1"},
    "verdict_id": {"type": "string", "pattern": "^FV-[0-9a-f]{24}$"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "candidate_id": {"type": "string", "pattern": "^FC-[0-9a-f]{24}$"},
    "issue_id": {"type": "string", "pattern": "^FI-[0-9a-f]{24}$"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "deployed_at"],
      "properties": {
        "receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "deployed_at": {"type": "string", "format": "date-time"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "opportunities", "metrics"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "opportunities": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observed_metric"}
        }
      }
    },
    "outcome": {"enum": ["improved", "neutral", "regressed"]},
    "follow_up": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_id"],
      "properties": {
        "kind": {"enum": ["verified-decision", "retriage", "rollback-candidate"]},
        "artifact_id": {
          "type": ["string", "null"],
          "pattern": "^(FD|FC)-[0-9a-f]{24}$"
        }
      }
    },
    "verdict_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "improved"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "follow_up": {
            "properties": {
              "kind": {"const": "verified-decision"},
              "artifact_id": {"type": "string", "pattern": "^FD-[0-9a-f]{24}$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "neutral"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "follow_up": {
            "properties": {
              "kind": {"const": "retriage"},
              "artifact_id": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "regressed"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "follow_up": {
            "properties": {
              "kind": {"const": "rollback-candidate"},
              "artifact_id": {"type": "string", "pattern": "^FC-[0-9a-f]{24}$"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "observed_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "value": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
      }
    }
  }
}
