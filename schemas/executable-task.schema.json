{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/executable-task.schema.json",
  "title": "PDCA executable task boundary",
  "type": "object",
  "required": ["id", "status", "meta"],
  "properties": {
    "id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "status": {"const": "InProgress"},
    "meta": {
      "type": "object",
      "required": ["phase", "active", "ontology_role", "ontology_anchor", "record", "execution_contract"],
      "properties": {
        "phase": {"const": "do"},
        "active": {"const": true},
        "ontology_role": {
          "enum": ["ontology_modeling", "ontology_projection", "ontology_conformance_verification"]
        },
        "ontology_anchor": {"type": "string", "pattern": "^ontology:[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$"},
        "record": {"type": "string", "minLength": 1},
        "execution_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_product", "required_actions", "constraints", "testable_signal"],
          "properties": {
            "work_product": {"type": "string", "minLength": 1},
            "required_actions": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "constraints": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "testable_signal": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
