{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/agent-context-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "files", "digest"],
  "properties": {
    "schema": {"const": "pdca.agent-context-manifest/v1"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
