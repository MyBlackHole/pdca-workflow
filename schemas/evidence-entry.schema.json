{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/evidence-entry.schema.json",
  "title": "PDCA evidence manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "file", "kind", "size", "digest", "at", "criteria"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "kind": {"type": "string", "minLength": 1},
    "size": {"type": "integer", "minimum": 0},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "at": {"type": "string", "format": "date-time"},
    "superseded_by": {"type": "string", "minLength": 1},
    "evidence_type_ref": {"type": "string", "pattern": "^ontology:.+/.+$"},
    "criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
