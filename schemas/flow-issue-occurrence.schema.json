{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdca.local/schemas/flow-issue-occurrence.schema.json",
  "title": "Immutable Flow Issue occurrence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "record_id",
    "task_id",
    "idempotency_key",
    "source",
    "category",
    "phase",
    "transition",
    "rule",
    "affected_component",
    "normalized_location",
    "issue_code",
    "occurred_at",
    "facts",
    "evidence_refs"
  ],
  "properties": {
    "schema": {"const": "pdca.flow-issue-occurrence/v1"},
    "event_id": {"type": "string", "pattern": "^FE-[0-9a-f]{24}$"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{4,}$"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": {
      "enum": ["transition-audit", "test", "tool", "agent", "user", "retrospective"]
    },
    "category": {
      "enum": [
        "conformance-deviation",
        "specification-gap",
        "tooling-failure",
        "gate-false-positive",
        "gate-false-negative",
        "capability-gap",
        "ai-usability"
      ]
    },
    "phase": {"enum": ["plan", "do", "check", "act", "archive"]},
    "transition": {
      "type": ["string", "null"],
      "enum": [null, "plan-to-do", "do-to-check", "check-to-act", "act-to-archive"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
      }
    },
    "affected_component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "normalized_location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "issue_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "gate_effect", "exit_code", "before_state", "after_state"],
      "properties": {
        "confidence": {"enum": ["observed", "inferred"]},
        "gate_effect": {"enum": ["none", "blocked", "allowed", "unknown"]},
        "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "before_state": {"type": ["string", "null"], "maxLength": 128},
        "after_state": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
